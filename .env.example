# ChromaDB 영속화 디렉터리 (PersistentClient가 데이터를 저장하는 경로)
CHROMA_PERSIST_DIR=./data/chroma

# 임베딩 모델
# 원래 BAAI/bge-m3를 쓰려 했으나 fastembed(0.8.0 기준)가 지원하지 않아
# 다국어 지원 모델인 intfloat/multilingual-e5-large(1024차원)로 대체했다.
# 주의: e5 계열은 bge-m3와 달리 "query: " / "passage: " 접두사가 성능에 영향을 준다.
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# fastembed 모델 다운로드 캐시 경로 (최초 실행 시 약 1~2GB 다운로드됨)
EMBEDDING_CACHE_DIR=./data/model_cache

# 업로드된 원본 PDF 저장 경로
UPLOAD_DIR=./data/uploads

# 청킹 기준선 (600자 / overlap 100자) - 검색 품질이 이상하면 가장 먼저 조정할 값
CHUNK_SIZE=600
CHUNK_OVERLAP=100
